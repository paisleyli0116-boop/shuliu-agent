{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shuliu:protocol:workflow:v1",
  "title": "ShuLiu workflow protocol v1",
  "allOf": [
    {
      "$ref": "urn:shuliu:protocol:common:v1#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "protocol_name": {
          "const": "workflow"
        },
        "protocol_version": {
          "const": 1
        },
        "payload": {
          "$ref": "urn:shuliu:protocol:common:v1#/$defs/payload"
        }
      },
      "required": [
        "protocol_name",
        "protocol_version",
        "payload"
      ]
    }
  ]
}
