{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shuliu:protocol:worker:v1",
  "title": "ShuLiu worker protocol v1",
  "allOf": [
    {
      "$ref": "urn:shuliu:protocol:common:v1#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "protocol_name": {
          "const": "worker"
        },
        "protocol_version": {
          "const": 1
        },
        "message_type": {
          "enum": ["register", "registered", "authenticate", "authenticated", "heartbeat", "lease_request", "lease_request_assigned", "no_assignment", "lease", "lease_authorize", "lease_authorized", "ack", "progress", "cancel", "result", "error"]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocol_name",
        "protocol_version",
        "message_type",
        "payload"
      ]
    },
    {
      "oneOf": [
        { "type": "object", "properties": { "message_type": { "const": "register" }, "payload": { "$ref": "#/$defs/register" } } },
        { "type": "object", "properties": { "message_type": { "const": "registered" }, "payload": { "$ref": "#/$defs/registered" } } },
        { "type": "object", "properties": { "message_type": { "const": "authenticate" }, "payload": { "$ref": "#/$defs/authenticate" } } },
        { "type": "object", "properties": { "message_type": { "const": "authenticated" }, "payload": { "$ref": "#/$defs/authenticated" } } },
        { "type": "object", "properties": { "message_type": { "const": "heartbeat" }, "payload": { "$ref": "#/$defs/heartbeat" } } },
        { "type": "object", "properties": { "message_type": { "const": "lease_request" }, "payload": { "$ref": "#/$defs/lease_request" } } },
        { "type": "object", "properties": { "message_type": { "const": "lease_request_assigned" }, "payload": { "$ref": "#/$defs/lease_request_assigned" } } },
        { "type": "object", "properties": { "message_type": { "const": "no_assignment" }, "payload": { "$ref": "#/$defs/no_assignment" } } },
        { "type": "object", "properties": { "message_type": { "const": "lease" }, "payload": { "$ref": "#/$defs/lease" } } },
        { "type": "object", "properties": { "message_type": { "const": "lease_authorize" }, "payload": { "$ref": "#/$defs/lease_authorize" } } },
        { "type": "object", "properties": { "message_type": { "const": "lease_authorized" }, "payload": { "$ref": "#/$defs/lease_authorized" } } },
        { "type": "object", "properties": { "message_type": { "const": "ack" }, "payload": { "$ref": "#/$defs/ack" } } },
        { "type": "object", "properties": { "message_type": { "const": "progress" }, "payload": { "$ref": "#/$defs/progress" } } },
        { "type": "object", "properties": { "message_type": { "const": "cancel" }, "payload": { "$ref": "#/$defs/cancel" } } },
        { "type": "object", "properties": { "message_type": { "const": "result" }, "payload": { "$ref": "#/$defs/result" } } },
        { "type": "object", "properties": { "message_type": { "const": "error" }, "payload": { "$ref": "#/$defs/error" } } }
      ]
    }
  ],
  "$defs": {
    "register": {
      "type": "object",
      "properties": {
        "registration_token": { "type": "string", "minLength": 1 },
        "worker_version": { "type": "string", "minLength": 1 },
        "protocol_version": { "const": 1 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "device_key_algorithm": { "type": "string", "minLength": 1 },
        "device_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}=?$" },
        "device_signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}(?:==)?$" }
      },
      "required": ["registration_token", "worker_version", "protocol_version", "capabilities", "device_key_algorithm", "device_public_key", "device_signature"]
    },
    "registered": {
      "type": "object",
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "session_credential": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      },
      "required": ["worker_id", "session_credential", "expires_at"]
    },
    "authenticate": {
      "type": "object",
      "properties": { "session_credential": { "type": "string", "minLength": 1 } },
      "required": ["session_credential"]
    },
    "authenticated": {
      "type": "object",
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 }
      },
      "required": ["worker_id"]
    },
    "heartbeat": {
      "type": "object",
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "sent_at": { "type": "string", "minLength": 1 }
      },
      "required": ["worker_id", "sent_at"]
    },
    "lease": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 },
        "task": { "type": "object" }
      },
      "required": ["task_id", "lease_id", "fencing_token", "idempotency_key", "expires_at"]
    },
    "lease_request": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "idempotency_key"]
    },
    "lease_request_assigned": {
      "type": "object",
      "properties": { "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "required": ["idempotency_key"],
      "additionalProperties": false
    },
    "no_assignment": {
      "type": "object",
      "properties": { "worker_id": { "type": "string", "minLength": 1 } },
      "required": ["worker_id"],
      "additionalProperties": false
    },
    "lease_authorize": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["task_id", "lease_id", "fencing_token", "idempotency_key"]
    },
    "lease_authorized": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expires_at": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "lease_id", "fencing_token", "idempotency_key", "expires_at"]
    },
    "ack": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "lease_id", "idempotency_key"]
    },
    "progress": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "progress": { "type": "object" }
      },
      "required": ["task_id", "lease_id", "idempotency_key", "progress"]
    },
    "cancel": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "lease_id", "reason_code"]
    },
    "result": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["SUCCEEDED", "FAILED", "CANCELLED"] },
        "result": { "type": "object" }
      },
      "required": ["task_id", "lease_id", "idempotency_key", "fencing_token", "status", "result"]
    },
    "error": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["task_id", "lease_id", "code", "retryable"]
    }
  }
}
