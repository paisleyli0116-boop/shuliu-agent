{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": ".ipc-test-build",
    "esModuleInterop": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts"]
}
