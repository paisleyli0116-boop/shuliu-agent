{
  "name": "@shuliu/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "vitest run --root .",
    "test:ui": "vitest run --root . tests/ui",
    "test:ipc": "vitest run --root . tests/ipc",
    "build:ipc-test": "node scripts/build-ipc-test.mjs",
    "typecheck": "tsc --project tsconfig.desktop.json --noEmit && tsc --project tsconfig.renderer.json --noEmit",
    "build": "tsc --project tsconfig.desktop.json && node scripts/mark-runtime-cjs.mjs && vite build --config vite.preload.config.ts && vite build --config vite.config.ts",
    "start": "electron ."
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
